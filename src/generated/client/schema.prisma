datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  userName    String   @unique
  fullName    String
  phoneNumber String
  schoolName  String
  schoolGrade String
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model School {
  id              Int     @id @default(autoincrement())
  schoolCode      String
  schoolName      String
  schoolShortName String
  schoolLogo      String?
}

model VideoItem {
  id         Int     @id @default(autoincrement())
  category   String
  thumbnail  String
  title      String
  duration   String
  instructor String
  views      String
  videoUrl   String?
}

model LeaderboardItem {
  id     Int    @id @default(autoincrement())
  rank   Int
  init   String
  name   String
  type   String
  points String
}

model DayActivity {
  id     Int       @id @default(autoincrement())
  day    String
  active Boolean[]
}

// ─── Examination ─────────────────────────────────────────────────────────────

model Exam {
  id                 String        @id @default(uuid())
  title              String
  description        String?
  time_limit_minutes Int?
  passing_score      Int           @default(50)
  is_published       Boolean       @default(false)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  questions          Question[]
  attempts           ExamAttempt[]
}

model Question {
  id             String          @id @default(uuid())
  exam_id        String
  content        String
  question_type  String // multiple_choice | true_false | short_answer
  options        Json? // [{ id: string, text: string }]
  correct_answer String?
  explanation    String?
  points         Int             @default(1)
  order_index    Int             @default(0)
  exam           Exam            @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  answers        AttemptAnswer[]
}

model ExamAttempt {
  id            String          @id @default(uuid())
  exam_id       String
  student_name  String
  student_email String
  started_at    DateTime        @default(now())
  submitted_at  DateTime?
  score         Float?
  passed        Boolean?
  exam          Exam            @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  answers       AttemptAnswer[]
}

model AttemptAnswer {
  id            String      @id @default(uuid())
  attempt_id    String
  question_id   String
  answer        String?
  is_correct    Boolean?
  points_earned Int         @default(0)
  attempt       ExamAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [question_id], references: [id], onDelete: Cascade)
}
