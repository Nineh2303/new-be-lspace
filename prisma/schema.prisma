datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  userName    String   @unique
  fullName    String
  phoneNumber String
  schoolName  String
  schoolGrade String
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model School {
  id              Int     @id @default(autoincrement())
  schoolCode      String
  schoolName      String
  schoolShortName String
  schoolLogo      String?
}

model VideoItem {
  id         Int     @id @default(autoincrement())
  category   String
  thumbnail  String
  title      String
  duration   String
  instructor String
  views      String
  videoUrl   String?
}

model LeaderboardItem {
  id     Int    @id @default(autoincrement())
  rank   Int
  init   String
  name   String
  type   String
  points String
}

model DayActivity {
  id     Int       @id @default(autoincrement())
  day    String
  active Boolean[]
}
